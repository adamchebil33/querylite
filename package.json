{
  "name": "querylite",
  "description": "SQL playground that runs DuckDB in the browser: query millions of rows without uploading them.",
  "license": "MIT",
  "repository": "github:adamchebil33/querylite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "REMOTE_AI=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test",
    "capture": "node scripts/capture-media.mjs",
    "record": "node scripts/record-demo.mjs",
    "build:samples": "node scripts/build-samples.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@observablehq/plot": "^0.6.19",
    "@tanstack/react-virtual": "^3.14.26",
    "apache-arrow": "17.0.0",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
