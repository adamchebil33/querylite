{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "querylite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-16",
  // Workers AI, used only by /api/ai. On the Free plan it stops with an error
  // once the daily allowance is used up; it never bills.
  "ai": { "binding": "AI" },
  // At most 5 AI requests per minute per visitor.
  "ratelimits": [
    { "name": "AI_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct"
  },
  "assets": {
    // Single-page app: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served as a static asset.
    "run_worker_first": ["/api/*"]
  }
}
